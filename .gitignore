# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
# PyInstaller leaves these next to the spec; ignore but keep the .spec checked in
*.spec.bak
wheels/
*.egg-info

# Virtual environments
.venv

# Mass spec data — too large for git, regenerable from raw or by re-running
# the tool. Don't commit by accident.
*.mzML
*.mzml
# ...except the committed test fixture under tests/data/, which we want
# travelling with the repo so the GUI/CLI can be smoke-tested on any
# machine (including freshly-bundled Windows builds) without hunting for
# a sample file.
!tests/data/*.mzML
!tests/data/*.mzml

